{
  "name": "webpagestudio/wps-micro-skeleton",
  "description": "Application skeleton for the WPS Micro framework",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Victor Galiuzov",
      "email": "victor8730@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "webpagestudio/wps-micro": "^3.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {"php": "8.3.0"},
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
    "quality": ["@format:check", "@analyse", "@test"]
  },
  "archive": {
    "exclude": [
      "**/.DS_Store",
      "/.env",
      "/.idea/",
      "/node_modules/",
      "/public/build/",
      "/storage/cache/phpunit/",
      "/storage/cache/twig/",
      "/storage/logs/*.log",
      "/vendor/"
    ]
  }
}
