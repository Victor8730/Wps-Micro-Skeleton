{% extends 'layouts/app.twig' %}
{% block title %}Log in | WPS Micro{% endblock %}
{% block content %}
<div class="mx-auto max-w-md">
    <h1 class="text-2xl font-semibold">Log in</h1>
    <form action="{{ route('login.store') }}" method="post" class="mt-7 space-y-5" data-validate novalidate>
        {{ csrf_field() }}
        {% include 'components/field.twig' with {name: 'email', label: 'Email address', type: 'email', autocomplete: 'email', maxlength: 255} only %}
        {% include 'components/field.twig' with {name: 'password', label: 'Password', type: 'password', autocomplete: 'current-password', minlength: 8, maxlength: 255} only %}
        <button type="submit" class="btn-primary w-full">Log in</button>
    </form>
    <p class="mt-6 text-sm text-zinc-600">No account yet? <a href="{{ route('register') }}" class="font-semibold underline">Create one</a></p>
</div>
{% endblock %}
