{% extends 'layouts/app.twig' %}
{% block title %}Create account | WPS Micro{% endblock %}
{% block content %}
<div class="mx-auto max-w-md">
    <h1 class="text-2xl font-semibold">Create account</h1>
    <form action="{{ route('register.store') }}" method="post" class="mt-7 space-y-5" data-validate novalidate>
        {{ csrf_field() }}
        {% include 'components/field.twig' with {name: 'name', label: 'Name', autocomplete: 'name', minlength: 2, maxlength: 120} only %}
        {% include 'components/field.twig' with {name: 'email', label: 'Email address', type: 'email', autocomplete: 'email', maxlength: 255} only %}
        {% include 'components/field.twig' with {name: 'password', label: 'Password', type: 'password', autocomplete: 'new-password', minlength: 8, maxlength: 255} only %}
        {% include 'components/field.twig' with {name: 'password_confirmation', label: 'Confirm password', type: 'password', autocomplete: 'new-password', minlength: 8, maxlength: 255} only %}
        <button type="submit" class="btn-primary w-full">Create account</button>
    </form>
    <p class="mt-6 text-sm text-zinc-600">Already registered? <a href="{{ route('login') }}" class="font-semibold underline">Log in</a></p>
</div>
{% endblock %}
