{% extends 'layouts/account.twig' %}
{% block title %}Account | WPS Micro{% endblock %}
{% block account_content %}
<h1 class="mb-6 text-2xl font-semibold">Profile</h1>
<dl class="max-w-xl divide-y divide-zinc-200">
    <div class="py-4"><dt class="text-sm text-zinc-500">Name</dt><dd class="mt-1 break-words">{{ auth_user.name }}</dd></div>
    <div class="py-4"><dt class="text-sm text-zinc-500">Email</dt><dd class="mt-1 break-all">{{ auth_user.email }}</dd></div>
    <div class="py-4"><dt class="text-sm text-zinc-500">Joined</dt><dd class="mt-1">{{ auth_user.created_at }}</dd></div>
</dl>
{% endblock %}
