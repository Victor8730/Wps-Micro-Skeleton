{% if pages > 1 %}
<nav aria-label="Pagination" class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-zinc-200 pt-4">
    {% if page > 1 %}<a class="btn-secondary" href="{{ route(route_name, {}, {page: page - 1}) }}" rel="prev">Previous</a>{% else %}<span></span>{% endif %}
    <span class="text-sm text-zinc-600">Page {{ page }} of {{ pages }}</span>
    {% if page < pages %}<a class="btn-secondary" href="{{ route(route_name, {}, {page: page + 1}) }}" rel="next">Next</a>{% else %}<span></span>{% endif %}
</nav>
{% endif %}
