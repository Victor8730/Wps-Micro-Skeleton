{% extends 'layouts/account.twig' %}
{% block title %}My messages | WPS Micro{% endblock %}
{% block account_content %}
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div><h1 class="text-2xl font-semibold">My messages</h1><p class="mt-1 text-sm text-zinc-500">{{ total }} total</p></div>
    <a class="btn-primary" href="{{ route('messages.create') }}">New message</a>
</div>
{% for message in messages %}
    <article class="border-t border-zinc-200 py-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <h2 class="min-w-0 break-words text-lg font-semibold">{{ message.title }}</h2>
            <div class="flex items-center gap-3">
                <a class="btn-secondary" href="{{ route('messages.edit', {id: message.id}) }}">Edit</a>
                <form action="{{ route('messages.delete', {id: message.id}) }}" method="post" data-confirm="Delete this message?">
                    {{ csrf_field() }}<input type="hidden" name="_method" value="DELETE">
                    <button class="btn-secondary text-red-700" type="submit">Delete</button>
                </form>
            </div>
        </div>
        <p class="mt-3 whitespace-pre-wrap break-words text-zinc-700">{{ message.body }}</p>
        <p class="mt-3 text-xs text-zinc-500">{{ message.created_at }}</p>
    </article>
{% else %}
    <p class="border-t border-zinc-200 py-10 text-zinc-500">No messages yet.</p>
{% endfor %}
{% include 'components/pagination.twig' with {route_name: 'messages.index'} %}
{% endblock %}
